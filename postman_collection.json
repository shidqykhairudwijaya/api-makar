        {
          "name": "Register Akun (Seller / Buyer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pak Haji Syahril\",\n  \"phone\": \"081299887766\",\n  \"email\": \"syahril.pasar@makar.id\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"role\": \"seller\",\n  \"store_name\": \"UD Berkah Cabai Segar\",\n  \"market_name\": \"Pasar Induk Kramat Jati\",\n  \"block_number\": \"Blok B-1 No. 45-48\",\n  \"full_address\": \"Jl. Raya Bogor No.KM. 19, Kramat Jati, Jakarta Timur\",\n  \"latitude\": -6.27510000,\n  \"longitude\": 106.86820000\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Mendaftarkan akun baru untuk role 'seller' (pedagang pasar induk) atau 'buyer' (pedagang pasar kecil/warung)."
          }
        },
        {
          "name": "Login (Auto-Save Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.token) {",
                  "        pm.collectionVariables.set(\"token\", json.data.token);",
                  "        console.log(\"Token tersimpan otomatis ke variabel {{token}}:\", json.data.token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"081300000001\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Login menggunakan nomor HP dan password. Akun demo:\n- Buyer: 081300000001 / password123\n- Seller: 081200000001 / password123\n- Courier: 081400000001 / password123\n- Admin: 081100000001 / password123"
          }
        },
